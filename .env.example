# SmartMeal local development environment.
# Copy to `.env` (`cp .env.example .env`). `.env` is git-ignored: NEVER commit real secrets.
# These values are for LOCAL development only. Staging/production secrets live elsewhere.

# --- PostgreSQL (used by the db container and by Django) ---------------------
POSTGRES_DB=smartmeal
POSTGRES_USER=smartmeal
POSTGRES_PASSWORD=change-me-local-only
# Host/port Django uses when run OUTSIDE Docker (inside Compose they are overridden to db:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-side published ports (change if already in use on your machine).
POSTGRES_HOST_PORT=5432
BACKEND_PORT=8000

# --- Django ------------------------------------------------------------------
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
DJANGO_LOG_LEVEL=INFO

# --- Docker build (Linux only; match `id -u` / `id -g` if your user is not 1000) --
# HOST_UID=1000
# HOST_GID=1000
